 ],
 "poems": [
  {
   "seq": "1",
   "text": "霜かれのころさへ月のやとりにて千年のかけそ松にのこれる",
   "kana": "",
   "speaker": "",
   "page": 394,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "つかへつゝよはひもたかき雲のうへの月の氷を袖にみるかな",
   "kana": "",
   "speaker": "",
   "page": 394,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "さえ渡る影そこほりてみかは水ともにすむ夜の月そくまなき",
   "kana": "",
   "speaker": "",
   "page": 394,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "小夜ふかき庭の木のはの霜の上に光をそへて氷る月哉",
   "kana": "",
   "speaker": "",
   "page": 394,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "さえわたる影もあまねき月よりや色もひとつの霜はをくらん",
   "kana": "",
   "speaker": "",
   "page": 394,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "ふくる夜の月にのこらぬ雲きえてさてもや影の猶こほるらん",
   "kana": "",
   "speaker": "",
   "page": 394,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "やとれ月露よりなれしおも影をさゆる霜よの袖にのこして",
   "kana": "",
   "speaker": "",
   "page": 394,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "更行は空にあらしの音さえて雲まの月の影そこほれる",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "雲井まて氷れる月や河竹の夜はなかはしにさえわたるらむ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "今ははや露をは霜に置かへてあらぬやとりの月の影かな",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "ひはらふく外山のひゝきさえくれて月の氷をまつあらしかな",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "氷るそとみるより空は猶さえて霜にへたてぬ月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "むら雲をはらひつくせる山風になをさえまさる冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "さえわたる雲ゐの月をみかは水うつれる影や猶こほるらん",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "霜さゆる嵐は松に音ふけて月は雲ゐに影こほるなり",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "更行は猶かけさむしあさちふの需にこほれる冬の夜の月",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "さゆる夜は氷かさねてみかは水猶すみまさる庭の月かけ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "今はゝやしきたつ澤のかけもみず氷にむかふ冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "をのつからたゝよふ雲もさゆる夜のあらしに晴てすめる月哉",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "有明のこほれる影をさきたてゝあらしふけ行山のはのそら",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "山のはも霜夜にさゆる松かえのあらしをわけていつる月かけ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "あきらけき君か光を猶そへて雲ゐにさゆるふゆのよの月",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "吹はらふ雲はあらしにとゝまらて空にさえ行冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "あまつ空霜も氷もむすふそと影よりみえてさゆる月かな",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "うちとけてれられぬ夜半の袖の霜むすひそへてや月も宿れる",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "吹風のゐなの笹原夜はふけて置そふ霜にこほる月かけ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "ふけぬるか猶影さむしをく霜のこゝのかされの冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "さゆる夜はいかなる霜の光にて秋より月のすみまさるらん",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "空まても霜をかさねてすむ月の更行まゝに影そこほれる",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "みるまゝに夜ふかき空の霜さえて袖にも月の影そこほれる",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "霜さゆるみかきの竹のよとゝもにかはらぬ月の影そこほれる",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "雲の波まで氷けりさゆる霜夜の月のひかりに",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "さゆる夜のほともしられて山端にこほれる雲を出る月かけ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "鐘の音もあらしとゝもに更行は霜夜の空にこほる月かけ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "さゆる夜はあらしの音もたかさこやおのへに氷る月のかけ哉",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "影にたにをくそとみえし霜の色の眞砂にふかき冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "くれ竹のさ枝にやとる月更てあられ吹まく夜半のこからし",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "風さゆる雲の衣にかけとめて氷かさぬるふゆのよのつき",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "久かたの雲ゐにさえてみかは水氷かさぬる干世の月かけ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "天津空霜にみちぬる夜はとてや月にさえ行かねの音かな",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "影こほる月をは袖にしきわひぬとけてれぬよの霜のさむしろ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "さえわたる月の氷もみかは水なかれひさしき御代てらすらし",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "さゆる夜も更行袖の霜の上に氷かさぬる月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "あけぬるか霜夜の鐘の聲よりも猶さえまさる月のかけ哉",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "澄みのほる影よりやかてさゆる夜は霜をもまたて月そ氷れる",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "さむしろやねられぬまゝにみつる哉霜もかさなる庭の月かけ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "天津空おさまる空の波間より光をそへてこほる月かな",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "夏の夜も霜かとみえし玉敷の庭のまさこの冬の月かけ",
   "kana": "",
   "speaker": "",
   "page": 395,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "時雨つる雲ものこらぬ山のはに月さえのほるみねのまつかせ",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "ふけ行はあらしも霜もさゆる夜に氷て月のかけそさやけき",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "久かたの空には月の氷る夜も雲の波たつかせのをとかな",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "うき雲ははらひつくして山風の更行まゝに月やさらゆむ",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "風さえてはれ行ほとのうき雲にこほりさためぬ月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "久方の空もひとつにすみのほる御はしの月の影のさむけき",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "强てふる我名もかけよ和歌の浦の玉もの雪の跡の白波",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "きゝしより名もむつましく思ふなり足利の浦につもる白雪",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "みわたせは波もひとつに白妙の雪にこきゆく浦のつりふね",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "松かせも音しつまりぬふる雪のつもりの浦の明ほのゝ空",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "しら波の關吹こゆるをとはして雪をそをくるすまの浦かせ",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "ふりにけりみほの松原それなから浦波しらむ雪の朝あけ",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "和歌の浦やくち木の松に降雪のつもれる年も今そかひある",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "波かゝるしつえはかりは嵐晴てまつにつもりの浦のしら雪",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "あゆの風吹こしの海もなってけり雪にこきいつるなこの浦舟",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "けさはなをきのふのうへに降そへて名さへつもりの浦の白雪",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "住吉のうら地明ゆく波まより雪にかくれぬあはちしまやま",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "なるみかた浦風とをし吹しきてしほひにつもる雪の明ほの",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "十かへりの花とみよとや和歌の浦の松の梢にふれるしら雪",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "あけてみは猶やつもらむ玉くしけふたみの浦のよはのしら雪",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "和歌の浦の道榮へゆく御代にありて雪分そむる跡やのこらん",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "吹風もをとたてぬまてよさの海の松にそつもる雪の明ほの",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "もしほくむ浦のとまやも埋れて雪をそわくるあまのかよひち",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "日影にも猶かゝやきて山あひのをみのうらはにはるゝしら雪",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "風さむみ末こす波とみしほとに雪そつもりの浦のまつ原",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "夕日さすいその松原はれそめて雪しつかなる浦風そふく",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "吹よはるほともしられて降雪のやかてつもりのうらの松かせ",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "志賀の浦さゝ波よするみきはとやふりつむ雪もした氷るらん",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "浦風になみもかゝらてふる雪に梢そなひくみほの松はら",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "木末には積りもあへす松風のふけゐの浦の雪の明かた",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "よるとみし木のまの波もうつもれぬうらはの松の雪の明ほの",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "あま人のしほくむたこのうら風に袖にも雪はなをつもりけり",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "浦ちかくなれて汐くむかよひちも雪にやたとるすまのあま人",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "住よしの浦よりをちはかつ晴て雪にそむかふあはちしまやま",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "浦遠きしほのひかたもしら波の又よするかとつもるしらゆき",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "なみ風もおさまる時とふりつみて雪そたかしのうらの松原",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "あま人の衣ほすまもしら雪のつもれはかゝる袖のうらなみ",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "かきくらしふるとはみれとうら風のつもりもあへぬ波の白雪",
   "kana": "",
   "speaker": "",
   "page": 396,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "夜もすからしかの浦波音たてゝあくる渚につもるしら雪",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "浦遠くふりくるほとをまつしまやをしまは雪のかつうつむ也",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "あけわたるよさの浦波ほの〓〓と雪よりしらむ天のはしたて",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "みくまのゝ浦にふれとも濵夕のいくへつもれるほともしら雪",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "關の戶は雪よりあけて須磨の浦や猶雪ふかしあはちしまやま",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "白雪のふるかひありて和歌の浦の松にや千世のあとを殘さん",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "明わたるよさのうら風吹しきて雪になり行天のはしたて",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "しきたへのとこの浦風しつまりてよのまは積る雪のあさあけ",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "きよみかたしほのみちひもみえわかて雪と波とに浦風そ吹く",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "和田のはら八十島がけてふる雪にさらにかきりも波の上かな",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "さゝ波や釣するあまの袖まても雪にそかへるしかのうらかせ",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "ふる雪のつもれはいとゝ浦風のをともおさまるみほの松原",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "うちよするおきつしら波をとさえて雪になるみの浦風そ吹く",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "ふりつもるみきはの雪を吹たてゝ波もたかしの浦の夕かせ",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "すみよしの浦ふく風もしつかにて濵まつかえにつもるしら雪",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "あとつけてまたふみなれぬ敷島や和歌のうらはの雪をみる哉",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "ふりはるゝひかたの雪をふきたてゝまたかき曇るおきつ鹽風",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "松にふくしほ風まてもうつもれて雪にのこるやみほのうら波",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "よさの海やうら風わたるはしたての雪もたえ〓〓みゆる松原",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "浦ちかくこきくる舟の笘しろくなみにもかけてみ雪ふるらし",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "松は猶さたかにみえて波風もおさまる浦の雪の明ほの",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "ふる雪の積りもあへす難波江の蘆のかれ葉にかゝる浦かせ",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "和田のはら雪にへたてし浦々もさたかにみゆる雪の明ほの",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "をしなへていつくの雪もかはかりや風しつかなる雪の明ほの",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "蘆牙とみえしかたちをはしめにてくにつ社の神のかしこさ",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "今は身のとしも五十鈴の川波の千たひ百たひわたらへの宮",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "君そすむかけをはうつすいはし水幾代のかすを數へかさねて",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "いはし水ゆく末遠き君か代を神もあらたにさそまもるらん",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "春日山ときはの松のかけにゐて猶すへらきの千年いのらん",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "君守る千代のためしといはし水なかれもきよみ神やすむらん",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "我君のあふくに神も老松の千年の友と猶やまもらむ",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "行末を思ふもひさしあとたれていく代へぬらんすみよしの松",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "六かへりのもゝ年あまりみ笠山あとたれし神のまもる此御代",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "かすかやま六十の老の坂こえぬ神と君とのめくみある代に",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "男山ちとせの坂もこえぬへし君かめくみの道にまかせて",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "いく千代か神ちの山のうちにみて外にあらはれ君まもるらん",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "八洲もる神の宮ゐをこゝのへの浦にいつよりいはひそめけん",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "たてかふる春日の神の宮柱千たひやちたひ君そみるへき",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "石〓水たえぬなかれを汲む君の千代もすむへき影やみゆらん",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "天の下くもらぬ御代とみかさ出さしてや君を猶まもるらむ",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "千代ふへき神のちかひやすみよしの松をためしのしき島の道",
   "kana": "",
   "speaker": "",
   "page": 397,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "松たにも久しときくを住吉の神は幾代かまもりきぬらん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "やはらくる光もたかし男山さかゆく御代をさそてらすらん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "あめつちの神代もきかすあし原や今ほと國のおさまりしとは",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "いはし水神のなかれの末遠くまもるにすめる君か御代哉",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "男山神のちかひもあらはれてさかゆく御代の末そひさしき",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "いはし水そこにふかめておもふ哉君かすむへき千代の久しさ",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "八百よろつかけてそすまむ石〓水にこりなき代を神に任せて",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "あふきみん君に賴みをかけまくもかしこき神の惠みある世に",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "跡たれてまもるも久しいはし水にこりなき世と神や住むらん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "上下の賀茂の社のゆふたすきかけてそいのる千代のゆくすゑ",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "石〓水すみはしめける代〓〓をへてたくひはあらし君か惠は",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "神かきもいま色そへてすみよしの松にや君か千世はみゆらむ",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "神もさそみもすそ川の末とをくたえせぬ御代を猶まもるらん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "代〓〓にこえまもるもしるし石〓水君か千年のかけを移して",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "治まれる御代にそいとゝしられける神は正しき道守るそと",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "あめつちのひろき惠を三笠山あまてる神や代をまもるらん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "やはらくる光を神もさしそへてさしてそまもる君かよろつ代",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "石〓水きよき流のたえせねは君か千年のかけそすみける",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "ちはやふるみかさの森のゆふたすきかけてそたのむ神の惠を",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "天津空ひかりをことにあふく哉てる日のみこと月よみの神",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "かす〓〓の神もまもれは君かへん八百萬代の末そひさしき",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "神もさそ心よすらんかすかやま今たちかふるにゐなみのみや",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "まもるらむ道をも代をもすみよしの宮居におなし玉津島姫",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "君か代に今たてかふる宮柱てらすひかりの日のくまの神",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "つきせしなわか神垣に朝なゆふな君をも代をもいのる心は",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "君かため幾代か神もすみよしの松のよはひをちきりをくらん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "榊葉に神のうけひくみしめ繩なひくにつけて代をいのる哉",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "千代かけて松に契りを住吉の神やかはらす道まもるらん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "道まもるちかひをきけはわきて猶心にたのむ住吉のかみ",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "君か代に千度うつさん神ち山瑞殿のみや宮つくりして",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "やはらくる光はおなしちりひちの山となるへき御代の行末",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "かす〓〓に君をそいのるさき草の三葉よつはの七の玉かき",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "住吉の神につかふる身にしあれは君をそいのる萬代まてと",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "おさまれる御代の千年をみくまのゝ神にまかせて猶いのる哉",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "君まもる七の神垣さらに又代〓〓にもこえて猶そさかへん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "いはし水神の誓のそのまゝににこらぬ御代をさそまもるらん",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "風月のあるしとなれる天神ひかりをそへよやまとこと葉に",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "もろ神のまもるしるしと君か代もともにさか行しきしまの道",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "よろつとしいのり重ねんちはやふる神てふ神の守る代なれは",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "やはた山神のいかきのみしめ繩なかゝれとのみ代をいのる哉",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "をしを山松の千年を契りつゝ神にそいのる君かゆくすゑ",
   "kana": "",
   "speaker": "",
   "page": 398,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "わきて猶千代とそいのるいはし水なかれ久しき君かめくみは",
   "kana": "",
   "speaker": "",
   "page": 399,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "天地のひとかなたらす君をまもるほしのくらゐや七の神かき",
   "kana": "",
   "speaker": "",
   "page": 399,
   "pid": "1879502",
